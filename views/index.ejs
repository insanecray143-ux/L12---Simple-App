<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Study Buddy Task Tracker</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials_header') %>

  <main class="container hero">
    <section>
      <p class="tag">Student productivity app</p>
      <h1>Study Buddy Task Tracker</h1>
      <p class="intro">Organise homework, assignments and revision tasks in one simple place.</p>
      <div class="actions">
        <a class="btn" href="/add">Add New Task</a>
        <a class="btn secondary" href="/tasks">View All Tasks</a>
      </div>
    </section>

    <section class="stats-card">
      <h2>Task Summary</h2>
      <div class="stats-grid">
        <div><strong><%= totalTasks %></strong><span>Total</span></div>
        <div><strong><%= pendingTasks %></strong><span>Pending</span></div>
        <div><strong><%= completedTasks %></strong><span>Completed</span></div>
      </div>
    </section>
  </main>
</body>
</html>